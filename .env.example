# Auto-generated .env template
# Fill in your API keys below

# LLM Configuration
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_PROD_MODEL=gpt-4o
# OPENAI_DEV_MODEL=gpt-4o-mini
# DEFAULT_LLM_MODEL=gpt-4o

# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-key-here

# Database
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# Authentication
# JWT_SECRET_KEY=change-this-to-a-random-string

# WhatsApp connector (delegate-connector-whatsapp) — all seven required for
# live (Tier-3) use; Tier-1/2 tests set what they need via monkeypatch/fixtures.
# WHATSAPP_ACCESS_TOKEN=your-cloud-api-bearer-token
# WHATSAPP_PHONE_NUMBER_ID=your-sending-phone-number-id
# WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_APP_SECRET=your-app-secret-for-x-hub-signature-256
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-hub-verify-token
# WHATSAPP_PII_HMAC_KEY=random-salt-for-wa-token-redaction
# WHATSAPP_APPROVED_TEMPLATES=order_update,appointment_reminder

# Slack connector (delegate-connector-slack). SLACK_BOT_TOKEN + optional
# SLACK_API_BASE_URL are the runtime keys; the SLACK_LIVE_E2E* set is opt-in
# Tier-3 only (Tier-1/2 use an in-process double, no creds needed).
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_API_BASE_URL=https://slack.com/api/
# SLACK_LIVE_E2E=1
# SLACK_LIVE_E2E_CHANNEL=C0123456789

# Telegram connector (delegate-connector-telegram). TELEGRAM_BOT_TOKEN +
# optional TELEGRAM_API_BASE are the runtime keys; the TELEGRAM_LIVE_E2E* set is
# opt-in Tier-3 only (Tier-1/2 use an in-process double, no creds needed).
# TELEGRAM_BOT_TOKEN=123456:your-bot-token
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_LIVE_E2E=1
# TELEGRAM_LIVE_E2E_CHAT_ID=your-sandbox-chat-id
# TELEGRAM_LIVE_E2E_USER_ID=your-sandbox-user-id
