#
# Email connector configuration. Copy to .env and fill in real values.
# NEVER commit a populated .env (root .gitignore excludes .env).
# All credentials are read from the environment — never hardcoded.

# --- SMTP (outbound) ---
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Set to "true" to require STARTTLS / implicit TLS. Mailpit local dev = false.
EMAIL_SMTP_USE_TLS=false

# --- IMAP (inbound) ---
EMAIL_IMAP_HOST=localhost
EMAIL_IMAP_PORT=1143
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_USE_TLS=false
