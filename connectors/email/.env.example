#
# Email connector configuration. Copy to .env and fill in real values.
# NEVER commit a populated .env (root .gitignore excludes .env).
# All credentials are read from the environment — never hardcoded.

# --- SMTP (outbound) ---
# Mailpit local dev: host=localhost, port=1025. (GreenMail SMTP = 3025.)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Set to "true" to require STARTTLS / implicit TLS. Mailpit local dev = false.
EMAIL_SMTP_USE_TLS=false

# --- IMAP (inbound) ---
# Mailpit v1.30.0 ships NO IMAP server; the inbound round-trip runs against
# GreenMail (real IMAP on 3143). Set USER to the recipient address so the
# transport can SELECT that mailbox.
EMAIL_IMAP_HOST=localhost
EMAIL_IMAP_PORT=3143
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_USE_TLS=false

# --- GreenMail (real SMTP + IMAP for the inbound round-trip) ---
EMAIL_GREENMAIL_HOST=localhost
EMAIL_GREENMAIL_SMTP_PORT=3025
EMAIL_GREENMAIL_IMAP_PORT=3143
